{
  "name": "sbg-figma-plugins",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "plugins/*"],
  "scripts": {
    "test": "node --test \"packages/core/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p plugins/pixel-render",
